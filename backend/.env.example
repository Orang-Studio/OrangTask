# Database
DATABASE_URL=postgresql://orangtask:orangtask@localhost:5432/orangtask

# Redis
REDIS_URL=redis://localhost:6379

# App
PORT=3001
NODE_ENV=development
APP_URL=http://localhost:5173
API_URL=http://localhost:3001
# Auth
SESSION_SECRET=change-this-to-a-random-256-bit-secret
COOKIE_DOMAIN=localhost
# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=noreply@yourdomain.com
# Google reCAPTCHA v2 (required for registration; login after two failed password attempts)
RECAPTCHA_SECRET_KEY=
# Public v2 site key used by the Android CAPTCHA Custom Tab (same value as VITE_RECAPTCHA_SITE_KEY)
RECAPTCHA_SITE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GitHub tracker integration (issues, pull requests, security alerts)
GITHUB_INTEGRATION_CLIENT_ID=
GITHUB_INTEGRATION_CLIENT_SECRET=
# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=